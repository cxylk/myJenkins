# myJenkins 配置示例：复制为 .env 后按需修改
# 注意：APP_SECRET 一旦用于加密凭据就不要随意更换，否则已保存的密钥无法解密。
# 留空则自动生成并保存在 data/master.key（需与 data 目录一起备份）。
APP_SECRET=

# 首次启动时创建的管理员账号（数据库已有用户后不再生效）
ADMIN_USERNAME=admin
# 留空则自动生成随机密码，并在容器日志中打印一次
ADMIN_PASSWORD=

# 服务监听
HOST_PORT=8080
TZ=Asia/Shanghai

# 同时执行的发布数量上限（1-8）
MAX_CONCURRENCY=2

# 单次发布日志上限（字节）与日志保留天数
LOG_MAX_BYTES=52428800
LOG_RETENTION_DAYS=90

# 通过 HTTPS 反向代理访问时设为 true（Session Cookie 仅走 HTTPS）
COOKIE_SECURE=false
# 反向代理后设为 true，以便获取真实客户端 IP / 协议
TRUST_PROXY=false

# 是否允许 file:// 或本地路径作为 Git 仓库（仅建议测试环境开启）
ALLOW_FILE_REPOS=false
# 是否允许 http:// 与 git:// 仓库（不加密传输，默认关闭）
ALLOW_INSECURE_GIT=false

# 单台目标机上传的硬超时（毫秒）与单次发布的最大时长（分钟）
UPLOAD_TIMEOUT_MS=1800000
MAX_BUILD_MINUTES=240

# 本地联调 SSH 目标机的密码
SSH_TARGET_PASSWORD=deploy-pass-123
