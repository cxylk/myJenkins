{
  "name": "myjenkins",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:server": "pnpm --filter @myjenkins/server dev",
    "dev:web": "pnpm --filter @myjenkins/web dev",
    "build": "pnpm --filter @myjenkins/web build && pnpm --filter @myjenkins/server build",
    "start": "node apps/server/dist/index.js",
    "test": "pnpm --filter @myjenkins/server test",
    "typecheck": "pnpm -r typecheck"
  }
}
